# ---- RemitWatch runtime configuration (copy to .env; never commit .env) ----

# SQLite store (holds PHI: keep it on an encrypted disk, back it up with the host's snapshots)
REMITWATCH_DB=data/remitwatch.sqlite
# Local mirror of the Dropbox folder
REMITWATCH_DATA_DIR=data/dropbox

# Dashboard login (one login shared by everyone who uses it; put the dashboard behind HTTPS). Use 12 or more plain letters and digits:
# on Vercel a shorter password counts as none and the site stays locked.
REMITWATCH_USER=oda
REMITWATCH_PASSWORD=change-me-to-something-long
# Optional second password, for the owner. When set, what each clinician is doing (the Providers tab, and lines
# billed per clinician on the Who and what tab) shows only after this password has been typed into the Providers tab.
# Everything else stays open to the login above. 12 or more plain letters and digits, not the same as
# REMITWATCH_PASSWORD. The page keeps it in memory only: reloading or closing the page locks the tab again.
#REMITWATCH_OWNER_PASSWORD=
# Show patient names in the detail view and letter previews (default off: initials and placeholders).
# Appeal packet PDFs always carry the name and member number, because the payer needs them.
REMITWATCH_SHOW_PHI=0

# ---- Dropbox: keeps the site current ----
# Create an app at https://www.dropbox.com/developers/apps (scoped access, Full Dropbox,
# permissions files.metadata.read + files.content.read, plus files.content.write on Vercel), then run:
# python -m remitwatch.cli oauth   (on Vercel the /setup page does this step)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=/Trizetto Data
# Only when the folder lives in a Dropbox team space (namespace id of the team root)
DROPBOX_PATH_ROOT_NS=
# Pull from Dropbox on this interval while the dashboard is running (0 = off). 60 is a good value.
REMITWATCH_SYNC_INTERVAL_MINUTES=60
# For instant updates, add https://YOUR-HOST/api/dropbox/webhook as a webhook URI in the Dropbox app.
# Seconds to wait after a webhook so a batch of uploads finishes before the cycle starts.
REMITWATCH_WEBHOOK_DEBOUNCE_SECONDS=45

# ---- Alerts and the summary report ----
# Any SMTP relay works; leave SMTP_HOST empty to skip email. These emails carry payer names, counts and dollars only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=remitwatch@example.com
REPORT_TO=
# Days between summary reports (alerts are sent as they are raised)
REMITWATCH_REPORT_EVERY_DAYS=7
# Optional: post new alerts to a Slack or Teams incoming webhook as {"text": "..."}
ALERT_WEBHOOK_URL=
# Alert windows: the last N days of payments are compared with the M days before them
REMITWATCH_ALERT_RECENT_DAYS=28
REMITWATCH_ALERT_BASELINE_DAYS=182
# Raise the "feed stopped" alert when no new remittance has arrived for this many days
REMITWATCH_STALE_DAYS=10

# ---- Appeal packets built from the visit note ----
# Set only after a business associate agreement covers this API organisation (see docs/OPERATIONS.md).
# Without a key, packets are still built from the template letter with the note attached.
ANTHROPIC_API_KEY=
REMITWATCH_NOTE_MODEL=claude-opus-5-5
# Remove known patient identifiers from the note text before it is sent for review (leave on)
REMITWATCH_NOTE_SCRUB=1
# Scanned PDFs have no text to clean, so they are not sent unless this is 1
REMITWATCH_NOTE_SEND_SCANS=0
# Packets hold patient information: limit where they can be emailed (comma-separated domains), and a default recipient
APPEAL_EMAIL_DOMAINS=example.com
APPEAL_EMAIL_TO=

# ---- Letterhead: who the appeal letters come from. Until these are set the letters carry bracketed words instead. ----
PRACTICE_NAME=
PRACTICE_ADDRESS=
PRACTICE_TIN=
PRACTICE_NPI=
PRACTICE_PHONE=
PRACTICE_FAX=
PRACTICE_EMAIL=

# ---- Serverless hosting (Vercel): see docs/VERCEL_SETUP.md ----
# The scheduler and the site's own follow-up runs present this. Made up, 16 characters or more, no spaces.
CRON_SECRET=
# Where the site keeps its store in Dropbox when it has no disk (needs the files.content.write permission)
REMITWATCH_STATE_PATH=/RemitWatch-state
# Seconds one run may take before it saves and continues in a fresh run; keep a minute under the function limit
REMITWATCH_MAX_SECONDS=240
# Leave unset on Vercel (detected). "serverless" with REMITWATCH_STATE_DIR=/some/folder tries that mode on a laptop.
REMITWATCH_MODE=
REMITWATCH_STATE_DIR=
# Archive read in one download on the first load, when the data folder has it
REMITWATCH_BACKFILL_ZIP=Trizetto.zip

# ---- Hosting ----
# Public name of the site, for the HTTPS certificate (docker compose)
SITE_ADDRESS=remitwatch.example.com
