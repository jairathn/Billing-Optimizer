# ---- RemitWatch runtime configuration (copy to .env; never commit .env) ----

# SQLite store (holds PHI: keep it on an encrypted disk, back it up with the host's snapshots)
REMITWATCH_DB=data/remitwatch.sqlite
# Local mirror of the Dropbox folder
REMITWATCH_DATA_DIR=data/dropbox

# Dashboard login (one login shared by everyone who uses it; put the dashboard behind HTTPS). Without a password the site
# serves no data, on the server as on Vercel. Use 12 or more plain letters and digits: on Vercel a shorter password counts
# as none and the site stays locked; the server still accepts a shorter one, so nobody is locked out, and /setup asks for a
# longer one.
# REMITWATCH_ALLOW_OPEN=1 opens the dashboard with no password. It is for a developer's own machine only: never set it on
# the server or on Vercel.
REMITWATCH_USER=oda
REMITWATCH_PASSWORD=change-me-to-something-long
# Optional second password, for the owner. When set, what each clinician is doing (the Providers tab, and lines
# billed per clinician on the Who and what tab) shows only after this password has been typed into the Providers tab.
# Everything else stays open to the login above. 12 or more plain letters and digits, not the same as
# REMITWATCH_PASSWORD. The page keeps it in memory only: reloading or closing the page locks the tab again.
#REMITWATCH_OWNER_PASSWORD=
# Show who each finding is about. 0 (the default): initials on screen, no patient column in the CSV export, and the
# claim ID to look the patient up in EMA. 1: the patient's name and member number in the work queue, the search box,
# the claim detail, letter previews and the CSV export, for everyone who can sign in.
# 0 hides names on the screens and in the export, nothing more: an appeal packet PDF carries the name and member
# number for every login, and the site serves dates of service and claim numbers either way. A long random
# REMITWATCH_PASSWORD and a host under a BAA are needed at 0 as much as at 1.
REMITWATCH_SHOW_PHI=0

# ---- Dropbox: keeps the site current ----
# Create an app at https://www.dropbox.com/developers/apps (scoped access, Full Dropbox,
# permissions files.metadata.read + files.content.read, plus files.content.write on Vercel), then run:
# python -m remitwatch.cli oauth   (on Vercel the /setup page does this step)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=/Trizetto Data
# Only when the folder lives in a Dropbox team space (namespace id of the team root)
DROPBOX_PATH_ROOT_NS=
# Pull from Dropbox on this interval while the dashboard is running (0 = off). 60 is a good value.
REMITWATCH_SYNC_INTERVAL_MINUTES=60
# For instant updates, add https://YOUR-HOST/api/dropbox/webhook as a webhook URI in the Dropbox app.
# Seconds to wait after a webhook so a batch of uploads finishes before the cycle starts.
REMITWATCH_WEBHOOK_DEBOUNCE_SECONDS=45

# ---- Alerts and the summary report ----
# Any SMTP relay works; leave SMTP_HOST empty to skip email. These emails carry payer names, counts and dollars only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=remitwatch@example.com
REPORT_TO=
# Days between summary reports (alerts are sent as they are raised)
REMITWATCH_REPORT_EVERY_DAYS=7
# Optional: post new alerts to a Slack or Teams incoming webhook as {"text": "..."}
ALERT_WEBHOOK_URL=
# Alert windows: the last N days of payments are compared with the M days before them
REMITWATCH_ALERT_RECENT_DAYS=28
REMITWATCH_ALERT_BASELINE_DAYS=182
# Raise the "feed stopped" alert when no new remittance has arrived for this many days
REMITWATCH_STALE_DAYS=10
# The practice's time zone. A filing window stays open until midnight there: every "today" the site compares a deadline,
# a follow-up or a fax's expiry with is this zone's date, and letters carry it. Default America/New_York (Kentucky and
# Indiana). An IANA name; one the host does not know falls back to the default, with a warning in the log.
REMITWATCH_TZ=America/New_York

# ---- Appeal packets built from the visit note ----
# The practice's business associate agreement with Anthropic covers this API organisation (signed November 2026).
# Without a key, packets are still built from the template letter with the note attached.
ANTHROPIC_API_KEY=
REMITWATCH_NOTE_MODEL=claude-opus-5-5
# Remove known patient identifiers from the note text before it is sent for review (leave on)
REMITWATCH_NOTE_SCRUB=1
# Scanned PDFs have no text to clean, so they are not sent unless this is 1
REMITWATCH_NOTE_SEND_SCANS=0
# Packets hold patient information: limit where they can be emailed (comma-separated domains), and a default recipient
APPEAL_EMAIL_DOMAINS=example.com
APPEAL_EMAIL_TO=

# ---- ModMed EMA: the visit note behind an appeal, read from EMA (docs/OPERATIONS.md, Connecting ModMed EMA) ----
# Make the key with: python -m remitwatch.cli modmed-key. The practice adds the client ID in EMA: Admin, Manage Bulk FHIR.
MODMED_CLIENT_ID=
MODMED_PRIVATE_KEY=
# Only where ModMed's registration names other values:
# MODMED_CLIENT_SECRET=  MODMED_API_KEY=  MODMED_FHIR_BASE=https://fhirmp.mmi.prod.fhir.ema-api.com/fhir/r4
# MODMED_TOKEN_URL=  MODMED_SCOPE=system/*.read  MODMED_AUDIENCE=  MODMED_KEY_ID=  MODMED_GROUP_ID=

# ---- TriZetto direct: remittances straight from TriZetto's SFTP (remitwatch.trizetto; docs/OPERATIONS.md, TriZetto direct) ----
# The login TriZetto issues for RemitWatch when asked in writing (docs/TRIZETTO_REQUEST.md): a second SFTP login of its own,
# not the Site ID's, which ModMed may sign in with. On the server, configure.sh asks for all of these. Nothing in TriZetto's
# portal is changed for it: not the Remittance Advice Settings, not the Site ID's SFTP password. The password comes by
# phone or in person, never by email.
TRIZETTO_SFTP_USER=
TRIZETTO_SFTP_PASSWORD=
# The day that password was set (YYYY-MM-DD) and how many days TriZetto lets it last: the data checks warn 20 days before.
TRIZETTO_SFTP_PASSWORD_SET=
TRIZETTO_SFTP_PASSWORD_DAYS=
# The folder TriZetto named for the 835 copies (empty: the whole login folder), and every host-key fingerprint TriZetto
# gave (SHA256:..., comma-separated)
TRIZETTO_SFTP_DIRS=
TRIZETTO_SFTP_HOSTKEY=
# Only if TriZetto names another server or port: TRIZETTO_SFTP_HOST=sftp.gatewayedi.com  TRIZETTO_SFTP_PORT=22
# The server reads TriZetto. A serverless host (Vercel) does not, unless this is 1; set it only where no server reads
# TriZetto with the same login (each site keeps its own hold on a refused password).
TRIZETTO_SFTP_SERVERLESS=

# ---- Fax line: appeals faxed and the payers' answers read (remitwatch.fax; docs/OPERATIONS.md, Faxing appeals) ----
# SRFax: a plan with a fax number and its business associate agreement. SRFAX_CALLER_ID is that number: letters give it,
# so answers come back.
SRFAX_ACCESS_ID=
SRFAX_ACCESS_PWD=
SRFAX_CALLER_ID=
SRFAX_SENDER_EMAIL=
# Which site sends the faxes. Only one does, so no fax goes out twice. server (the default): the practice's server.
# serverless: the Vercel site (set it there when no server runs). none: faxing is paused. The SRFAX_ settings can be on
# both sites: the other site shows the Faxes page and opens the faxes that came in, and sends nothing.
REMITWATCH_FAX_SENDER=server
# Faxing many appeals at once (Appeal everything appealable, Appeal by fax on ticked items) stays off until RemitWatch
# reads EMA's payments: it cannot yet tell a line paid on a check with no remittance from an unpaid one. One appeal opened
# and checked by a person still goes. 1 turns bulk faxing on.
REMITWATCH_BULK_APPEAL=
# Vercel only (optional): the address of the practice's own server site. The Vercel site's copy of the data holds only the
# claims that have items, so Find a claim names this site as the place to look up a paid claim with no item.
REMITWATCH_SERVER_SITE=

# ---- Letterhead: who the appeal letters come from. Until these are set the letters carry bracketed words instead. ----
PRACTICE_NAME=
PRACTICE_ADDRESS=
PRACTICE_TIN=
PRACTICE_NPI=
PRACTICE_PHONE=
PRACTICE_FAX=
PRACTICE_EMAIL=
# The Medicare PTAN the Part B contractor knows the practice by: the route card fills it into CGS's, WPS's and Palmetto's
# forms and phone lines (leave it empty and the card leaves the field for a person to fill)
PRACTICE_PTAN=

# ---- Serverless hosting (Vercel): see docs/VERCEL_SETUP.md ----
# The scheduler and the site's own follow-up runs present this. Made up, 16 characters or more, no spaces.
CRON_SECRET=
# Where the site keeps its store in Dropbox when it has no disk (needs the files.content.write permission)
REMITWATCH_STATE_PATH=/RemitWatch-state
# Seconds one run may take before it saves and continues in a fresh run; keep a minute under the function limit
REMITWATCH_MAX_SECONDS=240
# Leave unset on Vercel (detected). "serverless" with REMITWATCH_STATE_DIR=/some/folder tries that mode on a laptop.
REMITWATCH_MODE=
REMITWATCH_STATE_DIR=
# Archive read in one download on the first load, when the data folder has it
REMITWATCH_BACKFILL_ZIP=Trizetto.zip

# ---- EMA's A/R and Production (collections) reports: exported by hand from EMA, dropped in Dropbox or uploaded ----
# Which reports this host reads: all (both; the server's default), ar (the A/R only; the default on Vercel), off (neither).
# A report this host does not read is kept waiting and read once the setting allows. Vercel reads Production only from
# files of 60 MB or less (zip or gzip the CSV, or upload it in the app, which compresses it), one file per run.
REMITWATCH_EMA_REPORTS=
# "Open in EMA": a claim address with {claim} where the claim number goes, or off. Empty: learned from the reports.
REMITWATCH_EMA_CLAIM_URL=
# EMA payer names RemitWatch should group with a payer it knows, as JSON ({"EMA name": "payer group"}). Set it only in
# the host's own settings, never in the repository.
REMITWATCH_EMA_PAYER_ALIASES=
# Server: where the posting ledger of the Production report lives (about 140 MB for two years). Empty: beside the store.
REMITWATCH_EMA_LEDGER=
# Kept upload copies of a Production file whose rows newer files have replaced are deleted once this many newer files
# cover it (the catalog row stays)
REMITWATCH_EMA_REPORT_KEEP=2
# The most a file may weigh, in GB, as the Upload page sends it (after the page compresses it, when it does)
REMITWATCH_UPLOAD_MAX_GB=2
# Days of service the posting ledger keeps, counted back from its newest posting (at least 366). Empty: 1100 on a server,
# 730 on Vercel, whose temporary space (512 MB) must hold the ledger and its summaries' work at once. Retention that would
# delete more than 60% of the ledger at once waits for a person: python -m remitwatch.cli ema-reports --retain-force
REMITWATCH_EMA_RETAIN_DAYS=

# ---- Running on its own: the archive, the self-regulation and the self-audit (docs/TROUBLESHOOTING.md) ----
# The archive's horizon, in months of service: older settled claims leave the store for the archive (Find a claim still
# opens them). Empty: 36. Never below 24. The same value on both sites.
REMITWATCH_RETENTION_MONTHS=
# Server: where the archive's files go. Empty: archive/ beside the store (/data/archive). Vercel keeps them in the state
# folder's archive/.
REMITWATCH_ARCHIVE_DIR=
# The memory a run is measured against, in MB: past 80% of it the next run spreads its work and sheds optional steps, and
# the archive takes older claims sooner. Empty: 2188 on Vercel (inside its 2 GB function); on a server none for the
# self-regulation and 80% of the container's limit for the archive.
REMITWATCH_MEMORY_BUDGET_MB=
# Server: the seconds a cycle is measured against (past 80% of it the next cycle spreads its work). Empty: 3600. On Vercel
# a run has REMITWATCH_MAX_SECONDS.
REMITWATCH_CYCLE_BUDGET_SECONDS=
# How many new items on Work now that look settled the weekly self-audit allows before it raises its alert. Empty: 10.
REMITWATCH_AUDIT_WASTED_ITEMS=
# REMITWATCH_TODAY stands in for the practice's day in tests and simulations only. Never set it on a site: every
# deadline and every check would be counted from that day.

# ---- Hosting ----
# Public name of the site, for the HTTPS certificate (docker compose)
SITE_ADDRESS=remitwatch.example.com
