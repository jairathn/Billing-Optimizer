# HTTPS in front of the dashboard. Caddy obtains and renews the certificate for SITE_ADDRESS on its own.
{$SITE_ADDRESS} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	# uploads by hand (EMA's exports, remittance files, visit notes) may be large: a year of charge lines runs to tens of MB
	@uploads path /api/uploads /api/uploads/*
	request_body @uploads {
		max_size 260MB
	}
	@other not path /api/uploads /api/uploads/*
	request_body @other {
		max_size 20MB
	}
	reverse_proxy app:8000
}
