[Unit]
Description=RemitWatch auto-deploy: deploy the newest commit on main (build first, swap second)
Documentation=file:///opt/remitwatch/docs/SERVER_RUNBOOK.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/remitwatch
# the copy install-auto-deploy.sh made, not the checkout's file: a commit cannot change the deploy script that runs here
# as root (what it builds and starts still comes from main: docs/SERVER_RUNBOOK.md, "Who controls the server")
ExecStart=/bin/bash /usr/local/lib/remitwatch/auto-deploy.sh
TimeoutStartSec=50min
